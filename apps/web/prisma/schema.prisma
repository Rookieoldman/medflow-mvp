generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  role      Role
  firstName String?
  lastName1 String?
  lastName2 String?
  active       Boolean   @default(true)
  activeShift  Shift?
  breakUntil   DateTime?
  breakUsedAt  DateTime?

  // RELACIONES
  transfersCreated  Transfer[] @relation("TransfersCreated")
  transfersAssigned Transfer[] @relation("TransfersAssigned")
  incidentsCreated  Incident[] @relation("IncidentsCreated")
  transferEvents    TransferEvent[]
  pushSubscriptions PushSubscription[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  transferAcceptances TransferAcceptance[]
  passwordResetTokens PasswordResetToken[]
  shiftChangeLogs     ShiftChangeLog[]
}

/** Token de un solo uso para recuperación de contraseña (hash del secreto en URL). */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

enum TransferScope {
  PLANTA
  URGENCIAS
}

model Transfer {
  id                  String   @id @default(cuid())
  mrn                 String
  patientFullName     String
  dob                 DateTime
  location            String
  testType            TestType
  priority            Priority
  status              TransferStatus
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scope               TransferScope      @default(PLANTA)
  requiresAcceptance  Boolean            @default(true)
  difficulty          TransferDifficulty @default(MODERADO)

  previousStatus      TransferStatus?
  createdById         String
  assignedToId        String?

  createdBy           User     @relation("TransfersCreated", fields: [createdById], references: [id])
  assignedTo          User?    @relation("TransfersAssigned", fields: [assignedToId], references: [id])
  acceptance          TransferAcceptance?
  incidents           Incident[]
  events              TransferEvent[]
}

model TransferEvent {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id])

  fromStatus TransferStatus?
  toStatus   TransferStatus

  actorId    String
  actor      User    @relation(fields: [actorId], references: [id])

  note       String?
  createdAt  DateTime @default(now())
}

model TransferAcceptance {
  id String @id @default(cuid())

  transferId String   @unique
  transfer   Transfer @relation(fields: [transferId], references: [id])

  signerName    String
  signerRole    String?
  signatureData String
  signedAt      DateTime @default(now())

  celadorId String
  celador   User   @relation(fields: [celadorId], references: [id])
}

model Incident {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id])

  type IncidentType
  note String?

  createdById String
  createdBy   User   @relation("IncidentsCreated", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
}

enum Role {
  TECNICO
  CELADOR
  ADMIN
}

enum Priority {
  NORMAL
  URGENTE
}

enum TransferStatus {
  SOLICITADO
  ASIGNADO
  EN_CURSO
  EN_PRUEBA
  FINALIZADO
  PAUSADO
  CANCELADO
}

enum TransferDifficulty {
  BANAL
  MODERADO
  CRITICO
}

enum IncidentType {
  PACIENTE_NO_PREPARADO
  ESPERA_CLINICA
  PRUEBA_CANCELADA
  OTRO
}

enum TestType {
  RM
  ECO
  RX
  MEDICINA_NUCLEAR
  TC
}

enum Shift {
  MANANA
  TARDE
  NOCHE
}

/** Registro de cada cambio de turno: quién lo hizo, desde dónde y cuándo. */
model ShiftChangeLog {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromShift     Shift?
  toShift       Shift?
  changedAt     DateTime @default(now())
  changedByRole String   // "SELF" | "ADMIN"
  changedByName String

  @@index([userId])
  @@index([changedAt])
}
