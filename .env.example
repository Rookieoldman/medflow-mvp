# Copiar a apps/web/.env.local (o .env)

DATABASE_URL=postgresql://medflow:medflow@localhost:5432/medflow?schema=public

NEXTAUTH_SECRET=generar-con-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Recuperación de contraseña por correo (SMTP)
# Sin esto, «He olvidado mi contraseña» mostrará error de configuración.
# EMAIL_FROM debe ser una dirección permitida por tu relay SMTP.
SMTP_HOST=smtp.ejemplo.org
SMTP_PORT=587
# SMTP_SECURE=true   # usar true si el puerto es 465
# SMTP_USER=
# SMTP_PASSWORD=
EMAIL_FROM="MedFlow <noreply@hospital.org>"

# Opcional — notificaciones push (ver apps/web/scripts/generate-vapid.mjs)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contacto@hospital.org